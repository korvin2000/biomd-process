# Copy to .env and fill in. Values are referenced from the YAML config as ${VAR}.
# .env is git-ignored; never commit real keys.

# --- Local gateways (LiteLLM / OmniRoute / 9router / vLLM / Ollama) ---
LOCAL_LLM_BASE_URL=http://localhost:4000/v1
LOCAL_LLM_API_KEY=sk-local-anything

# --- OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=https://example.org
OPENROUTER_APP_NAME=biomd-process

# --- OpenAI (direct) ---
OPENAI_API_KEY=
