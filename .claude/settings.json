{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run test:watch)",
      "Bash(npm run build)",
      "Bash(npx vitest run:*)",
      "Bash(npm run biomd -- config check:*)",
      "Bash(npm run biomd -- config show:*)",
      "Bash(npm run biomd -- models:*)",
      "Bash(npm run biomd -- prompts:*)",
      "Bash(npm run biomd -- portrait:*)",
      "Bash(npm run biomd -- validate:*)",
      "Bash(npm run biomd -- report:*)",
      "Bash(npm run biomd -- run --dry-run:*)",
      "Bash(npm run score:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "ask": [
      "Bash(npm run biomd -- run:*)"
    ],
    "deny": []
  }
}
